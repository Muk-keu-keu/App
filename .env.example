# 이 파일을 .env 로 복사하고 실제 값을 채우세요. .env 는 커밋되지 않습니다.

# 추출에 쓸 AI 키. 둘 다 있으면 OpenAI 를 씁니다.
# Gemini 무료 등급은 모델·프로젝트당 하루 20건이라 시연 중에 닫힙니다.
# OpenAI API 키: https://platform.openai.com/api-keys
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# 구조화 출력(json_schema)을 지원하는 모델. 비우면 gpt-4.1-mini 를 씁니다.
OPENAI_MODEL=

# Gemini API 키: https://aistudio.google.com/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# 백엔드 주소. 비워 두면 앱이 더미 데이터로 돕니다(백엔드 없이 시연 가능).
# 값이 있으면 실제 서버를 쓰고, 로그인도 실제 계정으로 해야 합니다.
# 끝의 / 는 있어도 없어도 됩니다.
# 예: http://192.168.0.10:8080  /  https://api.mukbangyogi.com
API_BASE_URL=
